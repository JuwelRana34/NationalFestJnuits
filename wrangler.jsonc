{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "itfest",
  "keep_names": false,
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "itfest",
    },
    { "binding": "HONO_API", "service": "festapi" },
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "2aebade286de4babb2e1c5c6c6cb17ab",
    },
    {
      "binding": "IMAGES",
      "id": "2aebade286de4babb2e1c5c6c6cb17ab"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_id": "bdc00575-c7bd-4c98-9651-2a5a6cb21aaa",
      "database_name": "itsociety",
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://festapi.jnuits.org.bd",
    "CLOUDINARY_CLOUD_NAME": "dbwbwwteo",
    "CLOUDINARY_UPLOAD_PRESET": "itsociety",
  },
}
